generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Seat {
  id         String   @id @default(cuid()) @map("_id")
  tableId    String
  table      Table    @relation(fields: [tableId], references: [id])
  seat       Int
  isBooked   Boolean
  isReceived Boolean  @default(false)
  user       Users?   @relation(fields: [userId], references: [id])
  userId     String?
}

// Not Users It's guests but don't change the name of it now please.
model Users {
  id        String   @id @default(cuid()) @map("_id")
  firstname String
  lastname  String
  seat      Seat[]
  // Which event this guest belongs to (empty = not sorted yet)
  eventId   String?
}

model Table {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  Seat      Seat[]
  notes     String?
  // Where the table sits on the floor plan, as a percent of the plan's width/height.
  // Empty means "not placed yet" (the floor plan view lines it up automatically).
  posX      Float?
  posY      Float?
  // "round", "square" or "rectangle"
  shape     String   @default("round")
  // Size traced from the floor plan picture (% of picture width / height)
  sizeW     Float?
  sizeH     Float?
  // Which event this table belongs to
  eventId   String?
}

model Password {
  id        String   @id @default(cuid()) @map("_id")
  passsword String
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Image {
  id        String   @id @default(cuid()) @map("_id")
  filename  String
  data      String
  mimeType  String // Multipurpose Internet Mail Extensions type
  // The clean picture as uploaded, before table names were written on it
  original  String?
  size      Int
  createdAt DateTime @default(now())
  // Which event this floor plan belongs to
  eventId   String?
}

// One event (a wedding, a gala...): its own floor plan, tables and guests
model Event {
  id        String   @id @default(cuid())
  name      String
  date      String?
  createdAt DateTime @default(now())
}

// Small app-wide settings, e.g. which event is open right now
model Setting {
  key   String @id
  value String
}
